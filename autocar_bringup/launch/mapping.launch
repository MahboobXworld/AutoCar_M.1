<launch>
  <!-- Launch arguments -->
  <arg name="load_dynamic_obstacles" default="false"/>
  <arg name="world_name" default="$(find autocar_gazebo)/worlds/warehouse.world" if="$(arg load_dynamic_obstacles)"/>
  <arg name="world_name" default="$(find autocar_gazebo)/worlds/warehouse_clean.world" unless="$(arg load_dynamic_obstacles)"/>
  <arg name="paused" default="false"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="gui" default="true"/>
  <arg name="headless" default="false"/>
  <arg name="debug" default="false"/>

  <!-- 1. Start Gazebo World Simulation with GUI -->
  <include file="$(find autocar_gazebo)/launch/car_gazebo.launch">
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="$(arg use_sim_time)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="headless" value="$(arg headless)"/>
    <arg name="debug" value="$(arg debug)"/>
  </include>

  <!-- 2. EKF Localization (odom frame) -->
  <node pkg="robot_localization" type="ekf_localization_node" name="ekf_se_odom" clear_params="true" output="screen">
    <rosparam command="load" file="$(find autocar_localization)/config/localization/ekf.yaml" />
  </node>

  <!-- 3. LiDAR Deskewing Node -->
  <node pkg="autocar_localization" type="lidar_deskew_node" name="lidar_deskew_node" output="screen" respawn="true" />

  <!-- 4. SLAM Toolbox Node (mapping mode publishing straight to /map) -->
  <node pkg="slam_toolbox" type="async_slam_toolbox_node" name="slam_toolbox" output="screen">
    <rosparam command="load" file="$(find autocar_localization)/config/localization/slam_toolbox.yaml" />
    <remap from="map" to="/map" />
    <remap from="odom" to="/odometry/filtered" />
    <remap from="scan" to="/scan_deskewed" />
  </node>

  <!-- 5a. Hector Mapping (Scan Matching Engine) -->
  <node pkg="hector_mapping" type="hector_mapping" name="hector_mapping" output="screen">
    <param name="map_frame" value="map"/>
    <param name="base_frame" value="base_link"/>
    <param name="odom_frame" value="odom"/>
    
    <param name="use_tf_scan_transformation" value="true"/>
    <param name="use_tf_pose_start_estimate" value="false"/>
    
    <param name="pub_map_odom_transform" value="false"/>
    <param name="pub_odometry" value="true"/>
    
    <param name="update_factor_free" value="0.4"/>
    <param name="update_factor_occupied" value="0.9"/>
    <param name="map_update_distance_thresh" value="0.1"/>
    <param name="map_update_angle_thresh" value="0.1"/>
    
    <param name="map_resolution" value="0.05"/>
    <param name="map_size" value="1024"/>
    <param name="map_start_x" value="0.5"/>
    <param name="map_start_y" value="0.5"/>
    <param name="map_multi_res_levels" value="2"/>

    <remap from="scan" to="/scan_deskewed"/>
    <remap from="map" to="/hector_map"/>
    <remap from="map_metadata" to="/hector_map_metadata"/>
  </node>

  <!-- 5b. Localization Manager -->
  <node pkg="autocar_localization" type="localization_manager_node.py" name="localization_manager" output="screen" respawn="true">
    <param name="db_path" value="$(find autocar_ai)/database/fleet_learning.db" />
  </node>

  <arg name="use_web_teleop" default="true"/>

  <!-- 6. Launch Teleop Control -->
  <group if="$(arg use_web_teleop)">
    <node pkg="ros_teleop_control_agv" type="teleop_node.py" name="teleop_receiver" output="screen">
      <param name="wheelbase" value="0.70" />
      <param name="max_throttle_slew" value="100.0" />
      <param name="max_steering_slew" value="720.0" />
    </node>
  </group>
  <group unless="$(arg use_web_teleop)">
    <!-- Motion Smoother for Keyboard Command Mapping -->
    <node pkg="autocar_navigation" type="motion_smoother_node.py" name="motion_smoother" output="screen" respawn="true">
      <param name="wheelbase" value="0.70" />
      <param name="max_steer_angle" value="0.785398" />
      <param name="max_steer_rate_forward" value="1.57" />
      <param name="max_steer_rate_reverse" value="0.785" />
      <param name="max_steer_accel" value="3.14" />
      <param name="deadband_steer" value="0.0087" />
      <param name="lpf_steer_alpha" value="0.6" />
      <param name="lpf_vel_alpha" value="0.5" />
      <param name="max_accel" value="0.8" />
      <param name="max_jerk" value="1.5" />
      <param name="commitment_time" value="0.7" />
      <param name="commitment_time_parking" value="1.5" />
      <remap from="/cmd_vel_raw_behavior" to="/cmd_vel" />
    </node>
    <node pkg="teleop_twist_keyboard" type="teleop_twist_keyboard.py" name="teleop" output="screen" launch-prefix="xterm -e">
      <remap from="cmd_vel" to="/cmd_vel"/>
    </node>
  </group>

  <!-- 7. Launch RViz for Map Visualisation -->
  <node name="rviz" pkg="rviz" type="rviz" required="true"
        args="-d $(find autocar_description)/rviz/mapping.rviz"/>

</launch>
