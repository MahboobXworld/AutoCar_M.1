<launch>
  <arg name="use_rl" default="false"/>

  <!-- 1. Behavior Decision Manager -->
  <node name="behavior_decision_manager_node" pkg="autocar_behavior" type="behavior_decision_manager_node" output="screen" respawn="true">
    <param name="use_rl" value="$(arg use_rl)" />
    <remap from="navigate_behavior" to="navigate_behavior_bdm" />
  </node>

  <!-- 2. Situation Classifier Node -->
  <node pkg="autocar_behavior" type="situation_classifier_node.py" name="situation_classifier_node" output="screen">
    <param name="publish_rate" value="10.0"/>
  </node>

  <!-- 3. Mission Manager -->
  <node pkg="autocar_behavior" type="mission_manager.py" name="mission_manager" output="screen" respawn="true" />

  <!-- 4. Dynamic Obstacle Prediction and Behavior Planner -->
  <node pkg="autocar_behavior" type="dynamic_obstacle_planner_node.py" name="dynamic_obstacle_planner" output="screen" respawn="true">
    <param name="db_path" value="$(find autocar_ai)/database/fleet_learning.db" />
    <param name="wheelbase" value="0.70" />
    <param name="max_steer_angle" value="0.785398" />
  </node>
</launch>
