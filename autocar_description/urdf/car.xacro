<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="autocar">

  <!-- ===================== -->
  <!-- Parameters -->
  <!-- ===================== -->
  <xacro:property name="chassis_length" value="1.2"/>
  <xacro:property name="chassis_width"  value="0.6"/>
  <xacro:property name="chassis_height" value="0.2"/>
  <xacro:property name="wheel_radius"   value="0.12"/>
  <xacro:property name="wheel_width"    value="0.05"/>
  <xacro:property name="wheel_mass"     value="2.0"/>
  <xacro:property name="chassis_mass"   value="30.0"/>
  <!-- ===================== -->
  <!-- Global Materials -->
  <!-- ===================== -->
  <material name="dark_grey">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>
  <material name="tesla_red">
    <color rgba="0.8 0.05 0.05 1.0"/>
  </material>
  <material name="glass">
    <color rgba="0.1 0.1 0.1 0.75"/>
  </material>
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.9 0.0 0.0 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="blue_lidar">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>

  <!-- ===================== -->
  <!-- Base link (Chassis) -->
  <!-- ===================== -->
  <link name="base_link">
    <!-- Sleek Tesla-like Battery Skateboard Platform -->
    <visual>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} 0.08"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>

    <!-- Keep same collision box to maintain exact footprint and safety boundaries -->
    <collision>
      <origin xyz="0 0 ${chassis_height/2+0.07}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.17" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia ixx="1.0" iyy="3.7" izz="4.5"
               ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <!-- Aerodynamic Main Body Shell Link (Coloured Red in Gazebo) -->
  <link name="chassis_body_link">
    <!-- Aerodynamic Multi-coat Red Main Body Shell -->
    <visual>
      <origin xyz="-0.02 0 0.19" rpy="0 0 0"/>
      <geometry>
        <box size="1.15 ${chassis_width-0.02} 0.12"/>
      </geometry>
      <material name="tesla_red">
        <color rgba="0.8 0.05 0.05 1.0"/>
      </material>
    </visual>

    <!-- Sloped Sporty Passenger Cabin (Greenhouse Glass) -->
    <visual>
      <origin xyz="-0.10 0 0.28" rpy="0 0.08 0"/>
      <geometry>
        <box size="0.65 0.48 0.14"/>
      </geometry>
      <material name="glass">
        <color rgba="0.1 0.1 0.1 0.75"/>
      </material>
    </visual>

    <!-- Sleek Front Hood Sloped Panel -->
    <visual>
      <origin xyz="0.38 0 0.21" rpy="0 0.18 0"/>
      <geometry>
        <box size="0.30 ${chassis_width-0.05} 0.04"/>
      </geometry>
      <material name="tesla_red"/>
    </visual>

    <!-- Front Left Headlight (Tesla Signature LED strip look) -->
    <visual>
      <origin xyz="0.54 0.20 0.21" rpy="0 0 0.2"/>
      <geometry>
        <box size="0.05 0.10 0.02"/>
      </geometry>
      <material name="white">
        <color rgba="1.0 1.0 1.0 1.0"/>
      </material>
    </visual>

    <!-- Front Right Headlight -->
    <visual>
      <origin xyz="0.54 -0.20 0.21" rpy="0 0 -0.2"/>
      <geometry>
        <box size="0.05 0.10 0.02"/>
      </geometry>
      <material name="white"/>
    </visual>

    <!-- Rear Left Taillight -->
    <visual>
      <origin xyz="-0.58 0.22 0.21" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.08 0.02"/>
      </geometry>
      <material name="red">
        <color rgba="0.9 0.0 0.0 1.0"/>
      </material>
    </visual>

    <!-- Rear Right Taillight -->
    <visual>
      <origin xyz="-0.58 -0.22 0.21" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.08 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>

    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0.19" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="chassis_body_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_body_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===================== -->
  <!-- Steering Knuckles (Front Left and Right) -->
  <!-- ===================== -->
  
  <!-- Front Left Steering Knuckle -->
  <link name="front_left_steering_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.08"/>
      </geometry>
      <material name="grey">
        <color rgba="0.4 0.4 0.4 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.00035" ixy="0.0" ixz="0.0" iyy="0.00035" iyz="0.0" izz="0.00015"/>
    </inertial>
  </link>

  <joint name="front_left_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_steering_link"/>
    <origin xyz="0.35 0.40 ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.785" upper="0.785" effort="80.0" velocity="4.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Front Right Steering Knuckle -->
  <link name="front_right_steering_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.08"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.00035" ixy="0.0" ixz="0.0" iyy="0.00035" iyz="0.0" izz="0.00015"/>
    </inertial>
  </link>

  <joint name="front_right_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_steering_link"/>
    <origin xyz="0.35 -0.40 ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.785" upper="0.785" effort="80.0" velocity="4.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- ===================== -->
  <!-- Wheels (4 independent rolling wheels) -->
  <!-- ===================== -->
  
  <xacro:macro name="wheel_link_macro" params="name">
    <link name="${name}_wheel">
      <visual>
        <!-- Tire -->
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="0.0076" iyy="0.0144" izz="0.0076"
                 ixy="0.0" ixz="0.0" iyz="0.0"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="alloy_link_macro" params="name">
    <link name="${name}_wheel_alloy">
      <!-- White Star (*) Spokes on Side A (y = 0.024) -->
      <visual>
        <origin xyz="0 0.024 0" rpy="1.5708 1.5708 0"/>
        <geometry>
          <box size="0.15 0.052 0.005"/>
        </geometry>
        <material name="white">
          <color rgba="1.0 1.0 1.0 1.0"/>
        </material>
      </visual>
      <visual>
        <origin xyz="0 0.024 0" rpy="1.5708 2.61799 0"/>
        <geometry>
          <box size="0.15 0.052 0.005"/>
        </geometry>
        <material name="white"/>
      </visual>
      <visual>
        <origin xyz="0 0.024 0" rpy="1.5708 0.523599 0"/>
        <geometry>
          <box size="0.15 0.052 0.005"/>
        </geometry>
        <material name="white"/>
      </visual>

      <!-- White Star (*) Spokes on Side B (y = -0.024) -->
      <visual>
        <origin xyz="0 -0.024 0" rpy="1.5708 1.5708 0"/>
        <geometry>
          <box size="0.15 0.052 0.005"/>
        </geometry>
        <material name="white"/>
      </visual>
      <visual>
        <origin xyz="0 -0.024 0" rpy="1.5708 2.61799 0"/>
        <geometry>
          <box size="0.15 0.052 0.005"/>
        </geometry>
        <material name="white"/>
      </visual>
      <visual>
        <origin xyz="0 -0.024 0" rpy="1.5708 0.523599 0"/>
        <geometry>
          <box size="0.15 0.052 0.005"/>
        </geometry>
        <material name="white"/>
      </visual>

      <inertial>
        <mass value="0.01"/>
        <inertia ixx="0.00001" iyy="0.00001" izz="0.00001"
                 ixy="0.0" ixz="0.0" iyz="0.0"/>
      </inertial>
    </link>

    <joint name="${name}_wheel_alloy_joint" type="fixed">
      <parent link="${name}_wheel"/>
      <child link="${name}_wheel_alloy"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <gazebo reference="${name}_wheel_alloy_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>
  </xacro:macro>

  <!-- Create the wheel and alloy links at all four places -->
  <xacro:wheel_link_macro name="front_left"/>
  <xacro:alloy_link_macro name="front_left"/>

  <xacro:wheel_link_macro name="front_right"/>
  <xacro:alloy_link_macro name="front_right"/>

  <xacro:wheel_link_macro name="rear_left"/>
  <xacro:alloy_link_macro name="rear_left"/>

  <xacro:wheel_link_macro name="rear_right"/>
  <xacro:alloy_link_macro name="rear_right"/>

  <!-- Wheel joints -->
  
  <!-- Front Left Wheel (attached to steering knuckle) -->
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steering_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> 
    <limit effort="100.0" velocity="15.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- Front Right Wheel (attached to steering knuckle) -->
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_steering_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> 
    <limit effort="100.0" velocity="15.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- Rear Left Wheel (fixed steering, connected to base_link) -->
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.35 0.40 ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> 
    <limit effort="100.0" velocity="15.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- Rear Right Wheel (fixed steering, connected to base_link) -->
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.35 -0.40 ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> 
    <limit effort="100.0" velocity="15.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- ===================== -->
  <!-- Transmissions -->
  <!-- ===================== -->
  
  <!-- Front Left Steering Trans -->
  <transmission name="front_left_steering_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="front_left_steering_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="front_left_steering_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- Front Right Steering Trans -->
  <transmission name="front_right_steering_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="front_right_steering_joint">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="front_right_steering_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- Front Left Wheel Trans -->
  <transmission name="front_left_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="front_left_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="front_left_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- Front Right Wheel Trans -->
  <transmission name="front_right_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="front_right_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="front_right_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- Rear Left Wheel Trans -->
  <transmission name="rear_left_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rear_left_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="rear_left_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- Rear Right Wheel Trans -->
  <transmission name="rear_right_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rear_right_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="rear_right_motor">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- ===================== -->
  <!-- Sensors -->
  <!-- ===================== -->

  <!-- Front Camera -->
  <link name="front_camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <material name="red_cam">
        <color rgba="1.0 0.0 0.0 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="8e-6" ixy="0" ixz="0" iyy="8e-6" iyz="0" izz="8e-6"/>
    </inertial>
  </link>

  <joint name="front_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_camera_link"/>
    <origin xyz="0.6 0 0.22" rpy="0 0 0"/>
  </joint>

  <link name="front_camera_optical_link"/>
  <joint name="front_camera_optical_joint" type="fixed">
    <parent link="front_camera_link"/>
    <child link="front_camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <gazebo reference="front_camera_link">
    <sensor type="camera" name="front_camera_sensor">
      <update_rate>30.0</update_rate>
      <camera name="front_camera">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <plugin name="camera_controller_front" filename="libgazebo_ros_camera.so">
        <alwaysOn>true</alwaysOn>
        <updateRate>0.0</updateRate>
        <cameraName>front_camera</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frameName>front_camera_optical_link</frameName>
        <hackBaseline>0.07</hackBaseline>
        <distortionK1>0.0</distortionK1>
        <distortionK2>0.0</distortionK2>
        <distortionK3>0.0</distortionK3>
        <distortionT1>0.0</distortionT1>
        <distortionT2>0.0</distortionT2>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Rear Camera -->
  <link name="rear_camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <material name="red_cam"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="8e-6" ixy="0" ixz="0" iyy="8e-6" iyz="0" izz="8e-6"/>
    </inertial>
  </link>

  <joint name="rear_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_camera_link"/>
    <origin xyz="-0.6 0 0.22" rpy="0 0 3.14159265"/>
  </joint>

  <link name="rear_camera_optical_link"/>
  <joint name="rear_camera_optical_joint" type="fixed">
    <parent link="rear_camera_link"/>
    <child link="rear_camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <gazebo reference="rear_camera_link">
    <sensor type="camera" name="rear_camera_sensor">
      <update_rate>30.0</update_rate>
      <camera name="rear_camera">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <plugin name="camera_controller_rear" filename="libgazebo_ros_camera.so">
        <alwaysOn>true</alwaysOn>
        <updateRate>0.0</updateRate>
        <cameraName>rear_camera</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frameName>rear_camera_optical_link</frameName>
        <hackBaseline>0.07</hackBaseline>
        <distortionK1>0.0</distortionK1>
        <distortionK2>0.0</distortionK2>
        <distortionK3>0.0</distortionK3>
        <distortionT1>0.0</distortionT1>
        <distortionT2>0.0</distortionT2>
      </plugin>
    </sensor>
  </gazebo>

  <!-- IMU -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.3 0.1 ${chassis_height}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== -->
  <!-- GAZEBO INTEGRATION -->
  <!-- ===================== -->

  <!-- Gazebo Material and Friction -->
  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
    <mu1>0.9</mu1>
    <mu2>0.9</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
  </gazebo>

  <gazebo reference="chassis_body_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <gazebo reference="chassis_body_link">
    <material>Gazebo/Red</material>
  </gazebo>

  <!-- Set high friction for steering wheels to prevent sliding/slipping -->
  <gazebo reference="front_left_wheel">
    <material>Gazebo/Black</material>
    <mu1>10.0</mu1>
    <mu2>10.0</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
  </gazebo>
  <gazebo reference="front_left_wheel_alloy">
    <material>Gazebo/White</material>
  </gazebo>
 
  <gazebo reference="front_right_wheel">
    <material>Gazebo/Black</material>
    <mu1>10.0</mu1>
    <mu2>10.0</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
  </gazebo>
  <gazebo reference="front_right_wheel_alloy">
    <material>Gazebo/White</material>
  </gazebo>
 
  <gazebo reference="rear_left_wheel">
    <material>Gazebo/Black</material>
    <mu1>10.0</mu1>
    <mu2>10.0</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
  </gazebo>
  <gazebo reference="rear_left_wheel_alloy">
    <material>Gazebo/White</material>
  </gazebo>
 
  <gazebo reference="rear_right_wheel">
    <material>Gazebo/Black</material>
    <mu1>10.0</mu1>
    <mu2>10.0</mu2>
    <kp>1000000.0</kp>
    <kd>10.0</kd>
  </gazebo>
  <gazebo reference="rear_right_wheel_alloy">
    <material>Gazebo/White</material>
  </gazebo>

  <!-- ROS Control Plugin -->
  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/</robotNamespace>
      <param name="robotSimType" value="gazebo_ros_control/DefaultRobotHWSim"/>
    </plugin>
  </gazebo>

  <!-- 3D LiDAR -->
  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0012" ixy="0.0" ixz="0.0" iyy="0.0012" iyz="0.0" izz="0.0016"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.1"/>
      </geometry>
      <material name="blue_lidar"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.1"/>
      </geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.0 0 0.36" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo 2D LiDAR Plugin -->
  <gazebo reference="lidar_link">
    <material>Gazebo/Blue</material>
    <sensor type="ray" name="laser_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>40</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_head_hokuyo_controller" filename="libgazebo_ros_laser.so">
        <topicName>/scan</topicName>
        <frameName>lidar_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Gazebo IMU Plugin -->
  <gazebo>
    <plugin name="imu_plugin" filename="libgazebo_ros_imu.so">
      <alwaysOn>true</alwaysOn>
      <bodyName>imu_link</bodyName>
      <topicName>imu/data</topicName>
      <serviceName>imu_service</serviceName>
      <gaussianNoise>0.005</gaussianNoise>
      <updateRate>50.0</updateRate>
    </plugin>
  </gazebo>

</robot>
